# asta_authentication - environment variables reference
# Copy to .env and fill in real values. Never commit the real .env.

# --- Core Flask ---
# Flask session-signing / CSRF secret. MUST be a long random value in
# production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=change-me-to-a-long-random-value
# JWT signing secret (flask_jwt_extended). Falls back to SECRET_KEY if unset,
# but production should set its own distinct value.
JWT_SECRET_KEY=change-me-to-a-different-long-random-value
# Must be unset (or "false") in production - enables Werkzeug's interactive
# debugger (arbitrary code execution) and verbose tracebacks on error pages.
FLASK_DEBUG=false
# Cookie Secure flag. Defaults to True unless FLASK_DEBUG is set, so this
# normally does not need to be set explicitly in production (HTTPS required).
# SESSION_COOKIE_SECURE=true
# Port the app listens on when run directly (python app.py / run.py).
# Under gunicorn, use --bind instead; PORT is unused in that path.
PORT=5000

# --- Database ---
# SQLAlchemy DB URI. Defaults to a local SQLite file under instance/app.db
# if unset - set this to a real Postgres URL in production, e.g.:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///instance/app.db

# --- CORS ---
# Comma-separated list of origins allowed to make credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- Google OAuth ---
MOCK_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# --- Cross-app SSO / base URLs (other services in this monorepo) ---
# Shared HMAC secret for signing short-lived SSO handoff tokens - must be
# the SAME value on this app, the astra Django app, and ai-guru.
SSO_SHARED_SECRET=change-me-to-a-long-random-shared-value
# Django LMS app base URL.
ASTRALEARN_BASE_URL=http://localhost:8000
# ai-guru's user-facing frontend base URL (used for SSO redirect).
AI_GURU_FRONTEND_BASE_URL=http://localhost:3000
# ai-guru's FastAPI backend base URL (used for server-to-server analytics
# and career-GPS API calls). Same env var name astra/astralearn/settings.py
# uses for this service.
AI_GURU_BASE_URL=http://localhost:8001

# --- Optional integrations ---
# News feed widget (main_routes.py). Leave blank to disable.
GNEWS_API_KEY=

# --- Outbound email (password reset, etc. - auth_routes.py) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@astralearn.local
