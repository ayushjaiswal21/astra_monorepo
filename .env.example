# Root-level environment for docker-compose.yml ONLY.
# These are compose-level values (DB credentials, the shared SSO secret, and
# the public host/IP this VM is reachable at) used for ${VAR} substitution
# inside docker-compose.yml and for the inter-service hostname overrides.
#
# This is NOT a replacement for each app's own .env - astra/.env,
# asta_authentication/.env and ai-guru/backend/.env still hold each app's
# full configuration (API keys, SECRET_KEY, etc). See each app's own
# .env.example for those. Copy this file to ".env" at the repo root and
# fill in real values before running `docker compose up`.

# --- Public address of this VM ---
# The IP or domain name people/browsers will use to reach this server.
# Used to build the ai-guru frontend's API URL at build time (baked into
# the React bundle - it runs in the VISITOR'S BROWSER, so it must be a
# publicly reachable address, never an internal Docker service name).
PUBLIC_HOST=your-server-public-ip-or-domain

# --- Postgres for astra (Django/AstraLearn) ---
POSTGRES_ASTRA_DB=astralearn
POSTGRES_ASTRA_USER=astralearn
POSTGRES_ASTRA_PASSWORD=change-me-astra-db-password

# --- Postgres for asta_authentication (Flask SSO hub) ---
POSTGRES_AUTH_DB=astaauth
POSTGRES_AUTH_USER=astaauth
POSTGRES_AUTH_PASSWORD=change-me-auth-db-password

# --- Shared cross-app SSO secret ---
# MUST be identical across astra, asta_authentication and ai-guru/backend -
# it's how SSO handoff tokens are signed/verified between the three apps.
SSO_SHARED_SECRET=change-me-one-shared-secret-for-all-three-apps
