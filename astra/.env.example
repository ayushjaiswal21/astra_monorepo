# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core Django ---
# A strong, random string. In production (DEBUG=False) this is REQUIRED -
# the app will refuse to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Defaults to False in code if unset at all. Set True only for local dev.
DEBUG=False

# Comma-separated list of hostnames/IPs this app is allowed to serve, e.g.
# ALLOWED_HOSTS=example.com,www.example.com,203.0.113.10
# Required in production - Django rejects requests with an unrecognized Host
# header. Left unset, dev falls back to localhost/127.0.0.1 only.
ALLOWED_HOSTS=

# Set by Render automatically; harmless to leave unset elsewhere.
RENDER_EXTERNAL_HOSTNAME=

# --- HTTPS / reverse proxy (set these when deployed behind nginx/a load
# balancer that terminates TLS and forwards plain HTTP to this app) ---
# Only set True if your proxy actually sets X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Database ---
# If unset, falls back to local sqlite:///db.sqlite3. In production, point at
# Postgres, e.g.: postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Celery / Redis ---
# Must point at a real Redis instance reachable from this app and the worker.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- AI providers ---
GEMINI_API_KEY=your-gemini-api-key-here
JUDGE0_API_KEY=your-judge0-api-key-here
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=phi3:mini

# --- Static files CDN (optional) ---
USE_CDN=False
CDN_URL=

# --- Cross-app integration (ai-guru RAG tutor, Astra Auth SSO hub) ---
AI_GURU_BASE_URL=http://localhost:8001
SSO_SHARED_SECRET=change-me-shared-with-astra-auth
ASTRA_AUTH_BASE_URL=http://localhost:5000
