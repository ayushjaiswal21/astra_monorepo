# AI Guru Multibot Environment Configuration
# SECURITY: Never commit this file with real credentials!
# Copy to .env and fill in real values; .env is already gitignored.

# Google Gemini API Key (optional - app runs in degraded "mock mode" without it)
# Get from: https://makersuite.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Override to point Gemini calls at a mock/alternate endpoint (dev/test only).
# Leave unset in production.
GEMINI_API_BASE_URL=

# MongoDB connection URI (optional - app degrades gracefully to local/in-memory
# mode for chat and RAG if Mongo is unreachable; personalization/history are
# disabled in that mode). Use MongoDB Atlas or a self-hosted instance in prod.
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/ai_guru_db

# Shared secret for verifying SSO handoff JWTs from the Astra Auth (Flask) app.
# MUST exactly match that app's SSO_SHARED_SECRET. Change from the dev default
# before deploying - the code falls back to a known dev value if unset.
SSO_SHARED_SECRET=change-this-to-a-long-random-value-shared-with-astra-auth

# Comma-separated list of origins allowed by CORS. Falls back to the
# localhost dev origins if unset. Set this to your real frontend domain(s)
# in production, e.g.: https://app.example.com,https://astra.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Application environment. Set to "production" to hide the /docs Swagger UI.
# Options: development, production, staging
ENVIRONMENT=development

# Max uploaded image size in bytes for /image-chat (default 10MB)
MAX_FILE_SIZE=10485760

# Per-session request rate limit (requests per RATE_LIMIT_TIME_WINDOW seconds)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_TIME_WINDOW=60

# Security Notes:
# 1. Copy this file to .env and fill in your actual credentials
# 2. Never commit .env to version control
# 3. Use strong passwords for MongoDB Atlas
# 4. Rotate API keys regularly
# 5. Enable IP whitelisting in MongoDB Atlas
