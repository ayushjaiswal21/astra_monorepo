# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Node
node_modules/
build/

# VSCode
.vscode/

# Environment variables - CRITICAL SECURITY
.env*
!.env.example
.env.local
.env.production
.env.staging
.env.development
.env.test

# API Keys and credentials - NEVER COMMIT THESE
config.json
secrets.json
credentials.json
service-account.json
*.key
*.pem
*.p12
*-key.json
auth.json

# Database
*.db
*.sqlite
*.sqlite3

# Local model checkpoints: the small text-simplify encoder-decoder
# transformer (~48MB) IS committed (see backend/simplify_model/) so it
# works out of the box on a fresh deploy without a retraining step - this
# line intentionally does NOT exclude it. Nothing currently needs excluding
# here, left as a placeholder in case a future, larger model shouldn't be
# committed.

# Large files and media
*.wav
*.mp3
*.mp4
*.avi

# Logs
*.log
logs/

